<?xml version="1.0" encoding="utf-8"?>
<!--
  Permission Auditor — Themes
  Gerado pelo Claude Design System.

  TIPOGRAFIA:
  · Para habilitar Manrope e JetBrains Mono, adicione os arquivos .ttf em res/font/
    e descomente os itens android:fontFamily abaixo.
  · Download: fonts.google.com/specimen/Manrope e fonts.google.com/specimen/JetBrains+Mono
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PermissionAuditor" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- ── Cores principais ────────────────────────────── -->
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorPrimaryVariant">@color/brand_600</item>
        <item name="colorOnPrimary">@color/text_inverse</item>

        <item name="colorSecondary">@color/brand_300</item>
        <item name="colorSecondaryVariant">@color/brand_500</item>
        <item name="colorOnSecondary">@color/text_inverse</item>

        <item name="colorSurface">@color/bg_2</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="android:colorBackground">@color/bg_0</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <item name="colorError">@color/risk_high</item>
        <item name="colorOnError">@color/text_primary</item>

        <!-- ── Status / Nav bars ───────────────────────────── -->
        <item name="android:statusBarColor">@color/bg_0</item>
        <item name="android:navigationBarColor">@color/bg_0</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>

        <!-- ── Tipografia (Roboto do sistema — sem fontes externas) ─ -->
        <item name="android:fontFamily">sans-serif</item>

        <!-- ── Shape (cantos arredondados) ─────────────────── -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.PA.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PA.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.PA.Large</item>

    </style>

    <!-- Alias legado — evita crash se o tema antigo for referenciado -->
    <style name="Theme.GetorPermition" parent="Theme.PermissionAuditor" />

    <!-- ── Shape appearances ───────────────────────────────── -->
    <style name="ShapeAppearance.PA.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/r_sm</item>
    </style>

    <style name="ShapeAppearance.PA.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/r_md</item>
    </style>

    <style name="ShapeAppearance.PA.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/r_lg</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         TEXT APPEARANCES
         ═══════════════════════════════════════════════════════ -->

    <style name="TextAppearance.PA.Display" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textSize">@dimen/t_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.PA.H1" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/t_h1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.PA.H2" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/t_h2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PA.H3" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/t_h3</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PA.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/t_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PA.Small" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/t_small</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.PA.Caption" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">@dimen/t_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.PA.Mono" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/t_mono</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         BUTTON STYLES
         ═══════════════════════════════════════════════════════ -->

    <style name="Widget.PA.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/h_button_lg</item>
        <item name="cornerRadius">@dimen/r_md</item>
        <item name="backgroundTint">@color/brand_500</item>
        <item name="android:textColor">@color/text_inverse</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.PA.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/h_button_md</item>
        <item name="cornerRadius">@dimen/r_md</item>
        <item name="strokeColor">@color/border_default</item>
        <item name="android:backgroundTint">@color/bg_3</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PA.Button.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/h_button_md</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         CARD STYLE
         ═══════════════════════════════════════════════════════ -->

    <style name="Widget.PA.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_2</item>
        <item name="cardCornerRadius">@dimen/r_md</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
        <item name="contentPadding">@dimen/s_4</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         CHIP STYLE
         ═══════════════════════════════════════════════════════ -->

    <style name="Widget.PA.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="chipCornerRadius">@dimen/r_pill</item>
        <item name="chipMinHeight">@dimen/h_chip</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="android:textSize">@dimen/t_small</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         ALIASES LEGADOS (compatibilidade com layouts antigos)
         ═══════════════════════════════════════════════════════ -->

    <style name="Widget.PermissionAuditor.Button.Primary" parent="Widget.PA.Button.Primary" />
    <style name="Widget.PermissionAuditor.Chip" parent="Widget.PA.Chip" />

</resources>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_0">

    <!-- App icon (large) -->
    <ImageView
        android:id="@+id/iv_detail_icon"
        android:layout_width="@dimen/h_app_icon_lg"
        android:layout_height="@dimen/h_app_icon_lg"
        android:contentDescription="App icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/s_7" />

    <!-- App name -->
    <TextView
        android:id="@+id/tv_detail_name"
        style="@style/TextAppearance.PA.H2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/iv_detail_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/s_3"
        android:layout_marginStart="@dimen/s_6"
        android:layout_marginEnd="@dimen/s_6" />

    <!-- Package name (monospace style) -->
    <TextView
        android:id="@+id/tv_detail_package"
        style="@style/TextAppearance.PA.Mono"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@id/tv_detail_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/s_1"
        android:layout_marginStart="@dimen/s_6"
        android:layout_marginEnd="@dimen/s_6" />

    <!--
        Score container: shows either the numeric score (normal apps)
        OR the CRÍTICO status block (score = 0). Visibility toggled in DetailFragment.
    -->
    <FrameLayout
        android:id="@+id/container_score"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tv_detail_package"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/s_2">

        <!-- Normal: large score number -->
        <TextView
            android:id="@+id/tv_detail_score"
            style="@style/TextAppearance.PA.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/brand_500"
            android:gravity="center" />

        <!-- Critical (score = 0): emphasis status block -->
        <LinearLayout
            android:id="@+id/layout_critical_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible"
            android:background="@drawable/bg_critical_details_banner"
            android:paddingTop="@dimen/s_5"
            android:paddingBottom="@dimen/s_5"
            android:paddingStart="@dimen/s_4"
            android:paddingEnd="@dimen/s_4"
            android:layout_marginStart="@dimen/s_4"
            android:layout_marginEnd="@dimen/s_4"
            android:layout_marginTop="@dimen/s_2">

            <!-- CRÍTICO badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/risk_critical"
                android:textColor="@color/risk_critical_2"
                android:textSize="@dimen/t_caption"
                android:textStyle="bold"
                android:paddingStart="@dimen/s_3"
                android:paddingEnd="@dimen/s_3"
                android:paddingTop="@dimen/s_1"
                android:paddingBottom="@dimen/s_1"
                android:background="@drawable/bg_risk_badge_critical"
                android:layout_marginBottom="@dimen/s_3" />

            <!-- Score = 0 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Critical"
                android:textColor="@color/risk_critical"
                android:textSize="64sp"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/s_1" />

            <!-- Status label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/critical_alert_label"
                android:textColor="@color/risk_critical_2"
                android:textSize="@dimen/t_small" />

        </LinearLayout>

    </FrameLayout>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/stroke_thin"
        android:background="@color/border_subtle"
        app:layout_constraintTop_toBottomOf="@id/container_score"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/s_4"
        android:layout_marginStart="@dimen/s_4"
        android:layout_marginEnd="@dimen/s_4" />

    <!-- Section label -->
    <TextView
        android:id="@+id/tv_permissions_label"
        style="@style/TextAppearance.PA.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/detail_permissions_title"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/s_3"
        android:layout_marginStart="@dimen/s_4" />

    <!-- Permissions RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_detail_permissions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_constraintTop_toBottomOf="@id/tv_permissions_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/s_2" />

    <!-- Open Settings button -->
    <Button
        android:id="@+id/btn_open_settings"
        style="@style/Widget.PA.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/h_button_lg"
        android:text="@string/btn_open_settings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="@dimen/s_6"
        android:layout_marginStart="@dimen/s_7"
        android:layout_marginEnd="@dimen/s_7" />

</androidx.constraintlayout.widget.ConstraintLayout>

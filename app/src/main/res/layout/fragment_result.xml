<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_0">

    <!-- Global score card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_score"
        style="@style/Widget.PA.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/s_4"
        android:layout_marginStart="@dimen/s_4"
        android:layout_marginEnd="@dimen/s_4">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/s_5">

            <!-- Caption label -->
            <TextView
                android:id="@+id/tv_global_score_label"
                style="@style/TextAppearance.PA.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/global_score_label"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Big score number -->
            <TextView
                android:id="@+id/tv_global_score"
                style="@style/TextAppearance.PA.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/brand_500"
                app:layout_constraintTop_toBottomOf="@id/tv_global_score_label"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/s_1" />

            <!-- Status text ("Seguro", "Moderado", "Vulnerável") -->
            <TextView
                android:id="@+id/tv_score_status"
                style="@style/TextAppearance.PA.H3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                app:layout_constraintBottom_toBottomOf="@id/tv_global_score"
                app:layout_constraintStart_toEndOf="@id/tv_global_score"
                android:layout_marginStart="@dimen/s_3" />

            <!-- Apps count -->
            <TextView
                android:id="@+id/tv_apps_count"
                style="@style/TextAppearance.PA.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                app:layout_constraintTop_toBottomOf="@id/tv_global_score"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/s_1" />

            <!-- VPN badge -->
            <TextView
                android:id="@+id/tv_vpn_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vpn_active"
                android:textColor="@color/vpn_on"
                android:textSize="@dimen/t_caption"
                android:textStyle="bold"
                android:background="@drawable/bg_vpn_badge"
                android:paddingStart="@dimen/s_3"
                android:paddingEnd="@dimen/s_3"
                android:paddingTop="@dimen/s_1"
                android:paddingBottom="@dimen/s_1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Filter chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_filter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:paddingStart="@dimen/s_4"
        android:paddingEnd="@dimen/s_4"
        app:layout_constraintTop_toBottomOf="@id/card_score"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/s_3">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_all"
            style="@style/Widget.PA.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_all"
            android:checked="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_high"
            style="@style/Widget.PA.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_high" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_medium"
            style="@style/Widget.PA.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_medium" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_safe"
            style="@style/Widget.PA.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_safe" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Apps list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_apps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/s_2"
        android:paddingBottom="@dimen/s_4"
        app:layout_constraintTop_toBottomOf="@id/chip_group_filter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/s_2" />

</androidx.constraintlayout.widget.ConstraintLayout>

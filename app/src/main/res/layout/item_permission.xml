<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_2"
    android:layout_marginStart="@dimen/s_4"
    android:layout_marginEnd="@dimen/s_4"
    android:layout_marginBottom="@dimen/s_2"
    android:clipToPadding="false">

    <!-- Header row — always visible, clickable to expand -->
    <LinearLayout
        android:id="@+id/row_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/s_3"
        android:paddingEnd="@dimen/s_3"
        android:paddingTop="@dimen/s_3"
        android:paddingBottom="@dimen/s_3">

        <!-- Icon container (colored by risk level) -->
        <FrameLayout
            android:id="@+id/fl_icon_container"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_permission_icon">

            <ImageView
                android:id="@+id/iv_permission_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_info_details"
                android:contentDescription="Permission icon" />
        </FrameLayout>

        <!-- Permission name -->
        <TextView
            android:id="@+id/tv_permission_name"
            style="@style/TextAppearance.PA.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/s_3"
            android:layout_marginEnd="@dimen/s_2" />

        <!-- Risk badge -->
        <TextView
            android:id="@+id/tv_permission_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/t_caption"
            android:textStyle="bold"
            android:paddingStart="@dimen/s_2"
            android:paddingEnd="@dimen/s_2"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="@dimen/s_2" />

        <!-- Chevron indicator -->
        <TextView
            android:id="@+id/tv_chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Expandable risk detail section (hidden by default) -->
    <LinearLayout
        android:id="@+id/layout_risk_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="@dimen/s_3"
        android:paddingEnd="@dimen/s_3"
        android:paddingBottom="@dimen/s_3">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_thin"
            android:background="@color/border_subtle"
            android:layout_marginBottom="@dimen/s_2" />

        <!-- What the permission accesses -->
        <TextView
            android:id="@+id/tv_permission_explanation"
            style="@style/TextAppearance.PA.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/s_2" />

        <!-- "Em um app malicioso:" caption -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/malicious_app_risk_label"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/t_caption"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="@dimen/s_1" />

        <!-- 1 concrete malicious use case -->
        <TextView
            android:id="@+id/tv_permission_malicious_use"
            style="@style/TextAppearance.PA.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</LinearLayout>

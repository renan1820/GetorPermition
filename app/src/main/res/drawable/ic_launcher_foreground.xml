<?xml version="1.0" encoding="utf-8"?>
<!--
  Permission Auditor — Adaptive Icon Foreground
  Drop em: app/src/main/res/drawable/ic_launcher_foreground.xml

  Glyph: concentric "permission lens" — 3 rings + filled core
  Safe zone: keep content inside 66×66dp central area (Android crops borders)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:translateX="54" android:translateY="54">

        <!-- Outer ring -->
        <path
            android:strokeColor="#22D3EE"
            android:strokeWidth="2.4"
            android:strokeAlpha="0.55"
            android:pathData="M0,0 m-26,0 a26,26 0 1,1 52,0 a26,26 0 1,1 -52,0" />

        <!-- Middle ring -->
        <path
            android:strokeColor="#22D3EE"
            android:strokeWidth="2.4"
            android:strokeAlpha="0.85"
            android:pathData="M0,0 m-17,0 a17,17 0 1,1 34,0 a17,17 0 1,1 -34,0" />

        <!-- Inner core dot with cyan fill -->
        <path
            android:fillColor="#67E8F9"
            android:pathData="M0,0 m-7,0 a7,7 0 1,1 14,0 a7,7 0 1,1 -14,0" />

        <!-- Crosshair tick top -->
        <path
            android:fillColor="#22D3EE"
            android:pathData="M-1.2,-32 h2.4 v6 h-2.4 z" />
        <!-- Crosshair tick right -->
        <path
            android:fillColor="#22D3EE"
            android:pathData="M26,-1.2 h6 v2.4 h-6 z" />
        <!-- Crosshair tick bottom -->
        <path
            android:fillColor="#22D3EE"
            android:pathData="M-1.2,26 h2.4 v6 h-2.4 z" />
        <!-- Crosshair tick left -->
        <path
            android:fillColor="#22D3EE"
            android:pathData="M-32,-1.2 h6 v2.4 h-6 z" />

    </group>

</vector>
